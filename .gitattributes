# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot text formats — safe to diff and merge line-by-line.
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.import  text eol=lf
*.uid     text eol=lf

# Binary assets — never touch line endings, never try to merge.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.ogg     binary
*.wav     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
*.glb     binary
*.blend   binary
*.aseprite binary
*.ase     binary
*.res     binary
*.scn     binary
